<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>obstacle_monitor</name>
  <version>0.1.0</version>
  <description>Forward ultrasonic (DYP A21) obstacle detection: stop-and-wait zones for mission_manager and cmd_vel_bridge</description>
  <maintainer email="flash@todo.todo">flash</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>python3-serial</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
